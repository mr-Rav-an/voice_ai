DEEPGRAM_API_KEY=
PORT=3000

# Hindi voice. Options: deepgram (default, no extra key) | cartesia | elevenlabs
TTS_PROVIDER=cartesia
# CARTESIA_MODEL=
# CARTESIA_VOICE_ID=
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# --- Exotel (telephony) ---
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_CALLER_ID=
EXOTEL_SUBDOMAIN=api.exotel.com
# From Exotel Dashboard -> Settings -> API Settings
EXOTEL_ACCOUNT_SID=
# Numeric id of the Exotel App holding the Voicebot applet
EXOTEL_APP_ID=

# Shared secret in the Voicebot applet URL: wss://host/exotel-stream?token=
EXOTEL_STREAM_SECRET=

# --- MongoDB ---
MONGO_URI=
MONGO_DB=AI
